{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RemiPelloux/kill-my-idea/skills/kill/idea.schema.json",
  "title": "kill-my-idea idea brief",
  "description": "Structured brief extracted from the user's raw input. Fields not stated in the input are null and listed in unknowns. Never invent a value.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "created",
    "language",
    "source",
    "problem",
    "customer",
    "solution",
    "revenue_model",
    "countries",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$",
      "description": "The file format that wrote this file. \"1.0\" since kill-my-idea 1.0; files without it are pre-1.0 (run scripts/migrate.py)."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "created": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "own-idea",
            "tweet",
            "thread",
            "post",
            "article",
            "url",
            "doc",
            "voice-note",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "description": "Verbatim input"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "posted": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "problem": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer": {
      "type": [
        "string",
        "null"
      ],
      "description": "A precise segment, not 'everyone'"
    },
    "solution": {
      "type": [
        "string",
        "null"
      ]
    },
    "revenue_model": {
      "enum": [
        "subscription",
        "one-off",
        "usage",
        "ads",
        "affiliate",
        "marketplace",
        "service",
        "other",
        null
      ]
    },
    "price": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217, e.g. EUR"
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "month",
            "year",
            "one-off",
            "per-use",
            "per-seat-month",
            null
          ],
          "description": "Billing period. null when revenue_model has no price (ads, affiliate)."
        }
      },
      "required": [
        "amount",
        "currency"
      ]
    },
    "channel": {
      "type": [
        "string",
        "null"
      ],
      "description": "How the first customers are reached"
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "ISO 3166-1 alpha-2, e.g. FR, US. Launch country first."
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Claims from the source to fact-check, one per line, verbatim where possible"
    },
    "context": {
      "type": "object",
      "properties": {
        "budget": {
          "type": [
            "string",
            "null"
          ],
          "description": "Money available, with currency, e.g. 'EUR 500-5,000'"
        },
        "time_per_week": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. '10 h'"
        },
        "goal": {
          "enum": [
            "side-income",
            "startup",
            "audience",
            "learning",
            "other",
            null
          ]
        },
        "edge": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What was assumed because the user did not say (budget, country, price...). Each one is also stated in the report."
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of fields that are null after extraction and the questions, e.g. 'price', 'channel'"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "default": "en",
      "description": "The user's language, ISO 639-1. The HTML report has labels for en and fr; other languages fall back to en labels with the narrative in the user's language."
    },
    "type": {
      "enum": [
        "saas",
        "marketplace",
        "mobile_app",
        "ecommerce",
        "content",
        "service",
        "local"
      ],
      "description": "The kind of business; it picks the type checks and the question bank (SKILL.md §1-§3)."
    },
    "answers": {
      "type": "array",
      "maxItems": 10,
      "description": "Questions asked and the founder's answers. intake: before research (§2, at most 8). follow_up: after research (§3, at most 2).",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer",
          "feeds",
          "stage"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 200
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "feeds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sub-score, kill-shot or type-check keys this answer feeds, or country / confidence / rescue"
          },
          "stage": {
            "enum": [
              "intake",
              "follow_up"
            ]
          },
          "effect": {
            "type": "string",
            "maxLength": 160,
            "description": "follow_up only: what the answer changed, e.g. 'no channel -> clear, +6', or 'no change'"
          }
        }
      }
    }
  }
}
