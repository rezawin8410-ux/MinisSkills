#!/bin/sh
# pre-commit: refuse a commit whose ADDED lines look like they contain a secret (rules and allow list: tools/secret_scan.py).
# Plain sh on purpose: git runs hooks with the shell it ships (Git for Windows includes one), so this works on Linux, macOS and Windows.
# Reports show file, line and rule; the value itself is hidden. Override once after reviewing by eye:  git commit --no-verify
here=$(cd "$(dirname "$0")" && pwd -P)
hits=$(git diff --cached -U0 --no-color | sh "$here/../_run" secret_scan.py)
rc=$?
[ "$rc" -eq 0 ] && exit 0
if [ "$rc" -eq 1 ]; then
  echo "pre-commit: possible secret in the added lines (values hidden):" >&2
  printf '%s\n' "$hits" >&2
  echo "Remove it, store it where the notes say secrets live, or (after checking) git commit --no-verify." >&2
else
  echo "pre-commit: the secret scan could not run, so the commit is refused:" >&2
  printf '%s\n' "$hits" >&2
fi
exit 1
