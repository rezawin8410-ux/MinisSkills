#!/bin/sh
# _run: find a Python 3.8+ and run a tool script from this folder with it (Linux, macOS, Git Bash, WSL).
# Used by the extension-less launchers (notes-commit, bootstrap, ...) and by hooks/pre-commit.
here=$(cd "$(dirname "$0")" && pwd -P)
script="$1"; shift
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    exec "$c" -B "$here/$script" "$@"
  fi
done
echo "Python 3.8 or newer is required (python3, python or py was not found)" >&2
exit 127
